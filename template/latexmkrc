# latexmk config (coloca outputs em build/)
$out_dir = 'build';
$aux_dir = 'build';

# Compilar com pdflatex por default
$pdf_mode = 1;

# Se precisares de minted, ativa shell escape descomentando:
# $pdflatex = 'pdflatex -interaction=nonstopmode -synctex=1 -shell-escape %O %S';

# Parar em erros graves, mas continuar o suficiente para logs úteis
$interaction = 'nonstopmode';
